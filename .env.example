# =========================================================================
# MT5 TRADING BOT - ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in real values. Never commit ".env".
# =========================================================================

# --- MT5 Terminal Connection ---
# Leave MT5_PATH empty to attach to an already-running/logged-in terminal.
# Set it to the terminal64.exe path to have the bot launch/attach explicitly.
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Trading Mode ---
# DRY_RUN = generate signals only, never touch MT5 order API
# DEMO    = place real orders, but only allowed against a demo account
# LIVE    = place real orders on a live account. Requires TRADING_MODE=LIVE
#           AND LIVE_TRADING_CONFIRMED=YES_I_UNDERSTAND_THE_RISK, or the bot
#           refuses to start.
TRADING_MODE=DRY_RUN
LIVE_TRADING_CONFIRMED=

# --- Symbols traded (broker-side names mapped from canonical names) ---
# Canonical:Broker pairs, comma-separated. Broker name defaults to canonical
# if omitted after the colon.
SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCHF,USDCAD,NZDUSD,XAUUSD:XAUUSDm

# --- Timeframes ---
PRIMARY_TIMEFRAMES=M15,H1
TREND_CONFIRMATION_TIMEFRAME=H4

# --- Risk Management ---
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_WEEKLY_LOSS=0.08
MAX_OPEN_TRADES=3
MAX_TRADES_PER_DAY=10
MAX_EXPOSURE_PER_CURRENCY=0.03
MAX_SPREAD_POINTS=25
MIN_RISK_REWARD=2.0
MAX_DRAWDOWN_HALT=0.10

# --- Trading Sessions (UTC, 24h, comma-separated HH:MM-HH:MM ranges) ---
# Leave empty to allow trading at any time.
TRADING_SESSIONS=

# --- News Filter (optional) ---
NEWS_FILTER_ENABLED=false
NEWS_PROVIDER=none
NEWS_API_KEY=
NEWS_BLACKOUT_BEFORE_MIN=30
NEWS_BLACKOUT_AFTER_MIN=15

# --- Telegram Notifications (optional) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM Analysis Layer (optional, advisory-only, cannot place trades) ---
LLM_ENABLED=false
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Database ---
DATABASE_URL=sqlite:///./data/trading_bot.db

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000
# Required if API_HOST is ever changed to anything other than 127.0.0.1/
# localhost - the dashboard API has no built-in auth otherwise, and the
# app will refuse to start bound to a non-loopback address without this
# set. Send it back as the X-API-Key header. Leave blank for local-only use.
API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Magic number for order identification ---
MAGIC_NUMBER=990011
